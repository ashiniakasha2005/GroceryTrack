<file path="routes/productRoutes.ts">
import { Router } from 'express';
import { createProduct, updateProduct } from '../controllers/productController';
import { authenticateToken, authorizeRoles } from '../middleware/authMiddleware';
import { validateProductCategory } from '../middleware/categoryMiddleware';

const router = Router();

// Route to create a new product with admin authorization and category validation
router.post('/', authenticateToken, authorizeRoles('admin'), validateProductCategory, createProduct);

// Route to update an existing product with admin authorization and category validation
router.put('/:id', authenticateToken, authorizeRoles('admin'), validateProductCategory, updateProduct);

export default router;
