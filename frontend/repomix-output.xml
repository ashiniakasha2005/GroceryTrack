              </thead>

              <tbody>
                {filteredStaff.map((member) => {
                  // Keep each person's avatar colour stable, even while searching
                  const colorIndex = staff.findIndex(
                    (item) => item.id === member.id,
                  )

                  return (
                    <tr
                      key={member.id}
                      style={{ borderBottom: '1px solid #f1f3f5' }}
                    >
                      {/* Full Name */}
                      <td style={tableCellStyle}>
                        <div
