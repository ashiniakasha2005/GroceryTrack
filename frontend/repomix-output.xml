.product-modal .product-form-actions button[type='submit']:hover:not(:disabled) {
  border-color: #0b5ed7;
  background: #0b5ed7;
}

.product-modal .product-form-actions button:disabled,
.product-modal-close:disabled {
  cursor: not-allowed;
  opacity: 0.65;
}

@media (max-width: 480px) {
  .product-modal-overlay {
    align-items: flex-end;
    padding: 12px;
  }

  .product-modal {
    max-height: calc(100dvh - 24px);
  }

  .product-modal-header,
  .product-modal .product-form-fields {
    padding-right: 17px;
    padding-left: 17px;
  }

  .product-modal .product-form-fields {
    gap: 13px 10px;
  }

  .product-modal .product-form-actions {
    padding-right: 17px;
    padding-left: 17px;
  }
}
