import { useCallback, useEffect, useState } from 'react'
import ProductCatalogView from '../components/products/ProductCatalogView'
import ProductForm, {
  type ProductFormData,
} from '../components/products/ProductForm'
import DeleteConfirmationDialog from '../components/products/DeleteConfirmationDialog'
import type { Product } from '../types/product'
import SearchBar from '../components/SearchBar'
import { useCategories } from '../context/CategoryContext'
import { isLowStock } from '../utils/stock'
import { useNavigate } from 'react-router-dom'

const API_URL = 'http://localhost:3000/api'

interface ApiProduct {
  id: number
  name: string
  category: string | null
  price: number | string
  stock_quantity: number | string
  minimum_stock: number | string
}

async function request(path: string, options: RequestInit = {}) {
  const token = localStorage.getItem('token')

  const response = await fetch(`${API_URL}${path}`, {
    ...options,
    headers: {
      'Content-Type': 'application/json',
      Authorization: `Bearer ${token}`,
    },
  })

  const data = await response.json().catch(() => ({}))

  if (!response.ok) {
    throw new Error(data.message || 'Request failed')
  }

  return data
}

function toProduct(item: ApiProduct): Product {
  return {
    id: item.id,
    name: item.name,
    categoryName: item.category ?? '',
    price: Number(item.price),
    currentStock: Number(item.stock_quantity),
    minStockLevel: Number(item.minimum_stock),
    unit: 'pcs', // The database does not store a unit yet
  }
}

function ProductsPage() {
  const navigate = useNavigate()
  const { categories, categoryItems, refreshCategories } = useCategories()
  const [products, setProducts] = useState<Product[]>([])
  const [loadError, setLoadError] = useState('')
  const [search, setSearch] = useState('')
  const [categoryFilter, setCategoryFilter] = useState('All')
  const [showForm, setShowForm] = useState(false)
  const [editingProduct, setEditingProduct] = useState<Product | null>(null)
  const [deletingProduct, setDeletingProduct] = useState<Product | null>(null)

  const loadProducts = useCallback(async () => {
    const data: ApiProduct[] = await request('/products')
    setProducts(data.map(toProduct))
    setLoadError('')
  }, [])

  useEffect(() => {
    let cancelled = false

    request('/products')
      .then((data: ApiProduct[]) => {
        if (cancelled) return
        setProducts(data.map(toProduct))
        setLoadError('')
      })
      .catch((error) => {
        if (cancelled) return
        setLoadError(
          error instanceof Error ? error.message : 'Could not load products.',
        )
      })

    void refreshCategories()

    return () => {
      cancelled = true
    }
  }, [refreshCategories])

  const filteredProducts = products.filter((product) => {
    const matchesSearch = product.name
      .toLowerCase()
      .includes(search.trim().toLowerCase())

    const matchesCategory =
      categoryFilter === 'All' || product.categoryName === categoryFilter

    return matchesSearch && matchesCategory
  })

  const lowStockCount = products.filter(isLowStock).length

  const emptyMessage = loadError
    ? loadError
    : products.length === 0
      ? 'No products have been added yet.'
      : 'No products match your search.'

  function closeForm() {
    setShowForm(false)
    setEditingProduct(null)
  }

  async function handleSave(data: ProductFormData) {
    const category = categoryItems.find((item) => item.name === data.category)

    if (!category) {
      throw new Error('Category not found')
    }

    if (editingProduct) {
      // 1. Update the basic product details first
      await request(`/products/${editingProduct.id}`, {
        method: 'PUT',
        body: JSON.stringify({
          name: data.name,
          category_id: category.id,
          price: data.price,
          minimum_stock: data.minimumStock,
        }),
      })

      // 2. Check if stock was changed
      if (data.currentStock !== editingProduct.currentStock) {
        const difference = data.currentStock - editingProduct.currentStock;
        
        if (difference > 0) {
          // If adding stock, use the RESTOCK API (this prevents the backend error)
          await request(`/inventory/${editingProduct.id}/restock`, {
            method: 'POST',
            body: JSON.stringify({ quantity: difference }),
          });
        } else {
          // If reducing stock, use the PUT API
          await request(`/inventory/${editingProduct.id}`, {
            method: 'PUT',
            body: JSON.stringify({ quantity: data.currentStock }),
          });
        }
      }
    } else {
      await request('/products', {
        method: 'POST',
        body: JSON.stringify({
          name: data.name,
          category_id: category.id,
          price: data.price,
          stock_quantity: data.currentStock,
          minimum_stock: data.minimumStock,
        }),
      })
    }

    await loadProducts()
    closeForm()
  }

  async function handleConfirmDelete(productId: number) {
    await request(`/products/${productId}`, { method: 'DELETE' })
    await loadProducts()
    setDeletingProduct(null)
  }

  return (
    <div>
      <ProductCatalogView
        products={filteredProducts}
        totalCount={products.length}
        lowStockCount={lowStockCount}
        emptyMessage={emptyMessage}
        toolbar={
          <div className="flex items-center gap-3 rounded-[10px] border border-[#e9ecef] bg-white p-3.5">
            <div className="flex-1">
              <SearchBar
                value={search}
                onChange={setSearch}
                placeholder="Search products..."
              />
            </div>

            <select
              value={categoryFilter}
              onChange={(event) => setCategoryFilter(event.target.value)}
              aria-label="Filter by category"
              className="h-[38px] w-[150px] shrink-0 cursor-pointer rounded-md border border-gray-200 bg-white px-3 text-sm text-gray-800 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100"
            >
              <option value="All">All</option>
              {categories.map((category) => (
                <option key={category} value={category}>
                  {category}
                </option>
              ))}
            </select>
          </div>
        }
        onAddCategory={() => navigate('/categories')}
        onAdd={() => {
          setEditingProduct(null)
          setShowForm(true)
        }}
        onEdit={(product) => {
          setEditingProduct(product)
          setShowForm(true)
        }}
        onDelete={(product) => setDeletingProduct(product)}
      />

      {showForm && (
        <div
          className="product-modal-overlay"
          onMouseDown={(event) => {
            if (event.target === event.currentTarget) closeForm()
          }}
        >
          <ProductForm
            key={editingProduct?.id ?? 'new-product'}
            initialValues={
              editingProduct
                ? {
                    name: editingProduct.name,
                    category: editingProduct.categoryName,
                    unit: editingProduct.unit ?? 'pcs',
                    price: editingProduct.price,
                    currentStock: editingProduct.currentStock,
                    minimumStock: editingProduct.minStockLevel,
                  }
                : undefined
            }
            onSave={handleSave}
            onCancel={closeForm}
          />
        </div>
      )}

      {deletingProduct && (
        <DeleteConfirmationDialog
          productName={deletingProduct.name}
          onConfirm={() => handleConfirmDelete(deletingProduct.id)}
          onCancel={() => setDeletingProduct(null)}
        />
      )}
    </div>
  )
}

export default ProductsPage
</file>

<file path="SalesPage.tsx">
import { useEffect, useMemo, useState } from 'react'
import type { Product } from '../types/product'

const API_URL = 'http://localhost:3000/api'

interface ApiProduct {
  id: number
  name: string
  category: string | null
  price: number
  stock_quantity: number
  minimum_stock: number
  unit?: string
}

interface CartItem {
  product: Product
  quantity: number
}

function toProduct(item: ApiProduct): Product {
  return {
    id: Number(item.id),
    name: item.name,
    categoryName: item.category ?? '',
    price: Number(item.price),
    currentStock: Number(item.stock_quantity),
    minStockLevel: Number(item.minimum_stock),
    unit: item.unit ?? '',
  }
}

async function request(endpoint: string, options: RequestInit = {}) {
  const token = localStorage.getItem('token')

  if (!token) {
    throw new Error('Please log in to continue.')
  }

  const response = await fetch(`${API_URL}${endpoint}`, {
    ...options,
    headers: {
      'Content-Type': 'application/json',
      Authorization: `Bearer ${token}`,
      ...options.headers,
    },
  })

  const data = await response.json().catch(() => ({}))

  if (!response.ok) {
    throw new Error(data.message || 'Something went wrong.')
  }

  return data
}

export default function SalesPage() {
  const [products, setProducts] = useState<Product[]>([])
  const [cart, setCart] = useState<CartItem[]>([])
  const [search, setSearch] = useState('')
  const [loading, setLoading] = useState(true)
  const [loadError, setLoadError] = useState('')
  const [checkoutMessage, setCheckoutMessage] = useState('')
  const [checkoutError, setCheckoutError] = useState('')
  const [stockErrors, setStockErrors] = useState<Record<number, string>>({})
  const [checkingOut, setCheckingOut] = useState(false)

  // Fetch products from backend
  const fetchProducts = async () => {
    try {
      setLoadError('')

      const data = await request('/products')
      const productList = Array.isArray(data) ? data : data.products

      if (!Array.isArray(productList)) {
        throw new Error('Invalid product data received from server.')
      }

      setProducts(productList.map((item: ApiProduct) => toProduct(item)))
    } catch (error) {
      setLoadError(
        error instanceof Error
          ? error.message
          : 'Unable to load products.',
      )
    } finally {
      setLoading(false)
    }
  }

  // FIXED: Moved the async logic inside the effect to avoid warning
  useEffect(() => {
    let isMounted = true;
    const loadData = async () => {
      try {
        const data = await request('/products');
        if (!isMounted) return;
        const productList = Array.isArray(data) ? data : data.products;
        setProducts(productList.map((item: ApiProduct) => toProduct(item)));
      } catch (error) {
        if (!isMounted) return;
        setLoadError(error instanceof Error ? error.message : 'Unable to load products.');
      } finally {
        if (isMounted) setLoading(false);
      }
    };
    
    void loadData();
    return () => { isMounted = false; };
  }, []);

  // Search products by name or category
  const filteredProducts = useMemo(() => {
    const searchValue = search.toLowerCase().trim()

    return products.filter(
      (product) =>
        product.name.toLowerCase().includes(searchValue) ||
        product.categoryName.toLowerCase().includes(searchValue),
    )
  }, [products, search])

  // Calculate total dynamically
  const total = useMemo(
    () =>
      cart.reduce(
        (sum, item) => sum + item.product.price * item.quantity,
        0,
      ),
    [cart],
  )

  // Add product to cart
  const addToCart = (product: Product) => {
    setCheckoutMessage('')
    setCheckoutError('')

    if (product.currentStock <= 0) {
      setStockErrors((prev) => ({
        ...prev,
        [product.id]: 'This product is out of stock.',
      }))
      return
    }

    const existingItem = cart.find(
      (item) => item.product.id === product.id,
    )

    if (existingItem) {
      if (existingItem.quantity >= product.currentStock) {
        setStockErrors((prev) => ({
          ...prev,
          [product.id]: `Insufficient stock! Only ${product.currentStock} units available.`,
        }))
        return
      }

      setStockErrors((prev) => {
        const updatedErrors = { ...prev }
        delete updatedErrors[product.id]
        return updatedErrors
      })

      setCart(
        cart.map((item) =>
          item.product.id === product.id
            ? { ...item, quantity: item.quantity + 1 }
            : item,
        ),
      )
    } else {
      setCart([...cart, { product, quantity: 1 }])
    }
  }

  // Change cart quantity
  const changeQuantity = (productId: number, change: number) => {
    setCheckoutMessage('')
    setCheckoutError('')

    const existingItem = cart.find(
      (item) => item.product.id === productId,
    )

    if (!existingItem) {
      return
    }

    const newQuantity = existingItem.quantity + change

    if (newQuantity > existingItem.product.currentStock) {
      setStockErrors((prev) => ({
        ...prev,
        [productId]: `Insufficient stock! Only ${existingItem.product.currentStock} units available.`,
      }))
      return
    }
    setStockErrors((prev) => {
      const updatedErrors = { ...prev }
      delete updatedErrors[productId]
      return updatedErrors
    })

    setCart(
      cart
        .map((item) =>
          item.product.id === productId
            ? { ...item, quantity: newQuantity }
            : item,
        )
        .filter((item) => item.quantity > 0),
    )
  }

  // Complete sale
  const handleCheckout = async () => {
    if (cart.length === 0) {
      setCheckoutError('Please add at least one product.')
      return
    }

    try {
      setCheckingOut(true)
      setCheckoutError('')
      setCheckoutMessage('')

      await request('/sales', {
        method: 'POST',
        body: JSON.stringify({
          items: cart.map((item) => ({
            product_id: item.product.id,
            quantity: item.quantity,
          })),
        }),
      })

      setCart([])
      setCheckoutMessage('Sale completed successfully!')

      await fetchProducts()
    } catch (error) {
      setCheckoutError(
        error instanceof Error
          ? error.message
          : 'Unable to complete the sale.',
      )
    } finally {
      setCheckingOut(false)
    }
  }

  return (
    <div className="min-h-screen bg-gray-50 p-4 md:p-6">
      <div className="mx-auto max-w-7xl">

        {/* Page heading */}
        <div className="mb-6">
          <h1 className="text-2xl font-bold text-gray-800">
            Sales / POS Terminal
          </h1>

          <p className="mt-1 text-sm text-gray-500">
